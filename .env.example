# Public browser configuration only. Safe to expose to the frontend when RLS is configured.
# Copy this file to .env.local and replace both values with your Supabase project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Never add SUPABASE_SERVICE_ROLE_KEY here.
# The service-role key is used only by the local card import script in a temporary shell.
